<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0">

    <!-- FILTRO DE ADMINISTRADOR -->
    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>servlets.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/dashboard.jsp</url-pattern>
        <url-pattern>/LibroServlet</url-pattern>
        <url-pattern>/AutorServlet</url-pattern>
        <url-pattern>/CategoriaServlet</url-pattern>
        <url-pattern>/UsuarioServlet</url-pattern>
        <url-pattern>/PrestamoServlet</url-pattern>
    </filter-mapping>

    <!-- SERVLETS -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlets.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>servlets.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegistroServlet</servlet-name>
        <servlet-class>servlets.RegistroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistroServlet</servlet-name>
        <url-pattern>/RegistroServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CatalogoServlet</servlet-name>
        <servlet-class>servlets.CatalogoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CatalogoServlet</servlet-name>
        <url-pattern>/CatalogoServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DetalleLibroServlet</servlet-name>
        <servlet-class>servlets.DetalleLibroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DetalleLibroServlet</servlet-name>
        <url-pattern>/DetalleLibroServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SolicitarPrestamoServlet</servlet-name>
        <servlet-class>servlets.SolicitarPrestamoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SolicitarPrestamoServlet</servlet-name>
        <url-pattern>/SolicitarPrestamoServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MisPrestamosServlet</servlet-name>
        <servlet-class>servlets.MisPrestamosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MisPrestamosServlet</servlet-name>
        <url-pattern>/MisPrestamosServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LibroServlet</servlet-name>
        <servlet-class>servlets.LibroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LibroServlet</servlet-name>
        <url-pattern>/LibroServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AutorServlet</servlet-name>
        <servlet-class>servlets.AutorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AutorServlet</servlet-name>
        <url-pattern>/AutorServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoriaServlet</servlet-name>
        <servlet-class>servlets.CategoriaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoriaServlet</servlet-name>
        <url-pattern>/CategoriaServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UsuarioServlet</servlet-name>
        <servlet-class>servlets.UsuarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UsuarioServlet</servlet-name>
        <url-pattern>/UsuarioServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrestamoServlet</servlet-name>
        <servlet-class>servlets.PrestamoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrestamoServlet</servlet-name>
        <url-pattern>/PrestamoServlet</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
